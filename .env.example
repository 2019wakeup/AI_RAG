# ============================================================
# 沥知问答 · 环境变量示例（复制为 .env 后按需修改）
# 仅 .env.example 入库，.env 含密钥不入库
# ============================================================

# ===== LLM（OpenAI 兼容，默认 DeepSeek）=====
# 未配置或 LLM_OFF=1 时：报告与问答自动降级为模板/抽取式文案，检索与确定性计算不受影响
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_OFF=0

# ===== 嵌入模型 =====
# 注意：仓库不含预建索引，首次必须按所选模型重建：
#   EMBEDDING_MODEL=multilingual-e5-small pnpm build:index --rebuild --model=multilingual-e5-small
# 换模型 = 必须全量重建（provenance 强制），否则维度不匹配
# bge-m3（1024 维，效果更好、体积更大）| multilingual-e5-small（384 维，推荐，体积小）
EMBEDDING_MODEL=multilingual-e5-small
EMBEDDING_PREFIX_MODE=auto
HF_ENDPOINT=https://hf-mirror.com

# ===== 检索 =====
# lancedb（默认，向量+ANN）| sqlite（FTS5+精确 KNN，零原生依赖降级后端）
RETRIEVAL_BACKEND=lancedb
# RRF 两路权重（默认 1,1；"0,1" = 纯向量；"1,0" = 纯关键词）
HYBRID_WEIGHTS=1,1
# LLM 重排开关（默认开，需可用 LLM；off = 只用 RRF 原序）
RERANK=on
# MMR 多样性重排（默认 off；on 时可用 MMR_LAMBDA / MMR_POOL 调参）
MMR=off
MMR_LAMBDA=0.7
MMR_POOL=

# ===== 服务 =====
PORT=3011
# 前端开发服务器代理目标（vite 默认 http://localhost:3000）
API_PROXY_TARGET=http://localhost:3011
# e2e 脚本目标地址（默认 http://127.0.0.1:3000，需与后端端口一致）
E2E_BASE_URL=http://127.0.0.1:3011

# ===== 索引目录（默认 data/index；多索引对比时可覆盖）=====
INDEX_DIR=data/index
